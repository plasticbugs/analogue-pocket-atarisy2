<misterromdescription>
    <name>Championship Sprint</name>
    <setname>csprint</setname>
    <year>1986</year>
    <manufacturer>Atari Games</manufacturer>
    <category>Arcade</category>
    <rbf>atarisy2</rbf>

    <!-- Image format 2 (docs/hardware.md section 9): a 512-byte header, then
         fixed regions sized for the largest Atari System 2 game so one core
         reads every image the same way. Each region is laid out as MAME's
         memory region (gaps read 0x00 there and here), except that a
         region smaller than its slot is placed so that its two bit-plane
         halves sit where the full-size region's would (RGN_FRAC(1,2) of the
         SLOT), and the header's code widths say where the tile codes wrap.

           0x000000     512  header: "ASY2", format 2, game id, slapstic type,
                             flags (bit 0 TMS5220 fitted, bit 1 vertical screen),
                             playfield code bits, motion object code bits, name
           0x000200   32768  T11 fixed program 0x8000-0xffff (7l even byte, 7n odd)
           0x008200  524288  T11 banked program, MAME region 0x10000-0x8ffff (64 banks of 8 KB)
           0x088200   49152  6502 program 0x4000-0xffff
           0x094200  524288  playfield tiles, MAME "tiles" region
           0x114200 1048576  motion object tiles, MAME "sprites" region (as dumped; the core inverts)
           0x214200   16384  alphanumerics, MAME "chars" region
           0x218200     512  2804 EEPROM factory contents
           0x218400          total
    -->
    <rom index="0" zip="csprint.zip" md5="dfa5873cf7737ccc07bf409843b5da75">

        <!-- header: magic, format, game 3, slapstic 109, flags 0x00, pf/mo code bits 14/11, name -->
        <part>41 53 59 32 02 03 6d 00 0e 0b 00 00 00 00 00 00 43 48 41 4d 50 49 4f 4e 53 48 49 50 20 53 50 52 49 4e 54 00 00 00 00 00 00 00 00 00 00 00 00 00</part>
        <part repeat="464">00</part>

        <!-- T11 fixed program: little-endian words, 7l on the even byte -->
        <interleave output="16">
            <part name="136045-3126.7l" crc="1dcf8b98" map="10"/>
            <part name="136045-2127.7n" crc="bdcbe42c" map="01"/>
        </interleave>

        <!-- banked program, MAME region 0x10000-0x8ffff: 32 KB pairs at
             0x10000, 0x50000 and 0x70000, each stored twice (init_csprint
             expands them to 64 KB chunks); 0x30000-0x4ffff not fitted -->
        <interleave output="16">
            <part name="136045-2125.6f" crc="76cc68b9" map="10"/>
            <part name="136045-2122.6n" crc="87dda6e5" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="136045-2125.6f" crc="76cc68b9" map="10"/>
            <part name="136045-2122.6n" crc="87dda6e5" map="01"/>
        </interleave>
        <part repeat="131072">00</part>
        <interleave output="16">
            <part name="136045-1124.6k" crc="47efca1f" map="10"/>
            <part name="136045-1121.6r" crc="6ca404bb" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="136045-1124.6k" crc="47efca1f" map="10"/>
            <part name="136045-1121.6r" crc="6ca404bb" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="136045-1123.6l" crc="0a4d216a" map="10"/>
            <part name="136045-1120.6s" crc="103f3fde" map="01"/>
        </interleave>
        <interleave output="16">
            <part name="136045-1123.6l" crc="0a4d216a" map="10"/>
            <part name="136045-1120.6s" crc="103f3fde" map="01"/>
        </interleave>

        <!-- 6502 program: nothing at 0x4000-0x7fff, ROMs at 0x8000-0xffff -->
        <part repeat="16384">00</part>
        <part name="136045-1118.2bc" crc="eba41b2f"/>
        <part name="136045-1119.2d" crc="9e49043a"/>

        <!-- playfield tiles: MAME "tiles" region, 0x80000. 7a and 7de are
             64 KB ROMs loaded second half first (ROM_CONTINUE) -->
        <part name="136045-1105.6a" crc="3773bfbb"/>                                    <!-- 00000 -->
        <part name="136045-1106.6b" crc="13a24886"/>                                    <!-- 08000 -->
        <part name="136045-1101.7a" crc="5a55f931" offset="0x8000" length="0x8000"/>   <!-- 10000 -->
        <part name="136045-1102.7b" crc="37548a60"/>                                    <!-- 18000 -->
        <part repeat="65536">00</part>                                                 <!-- 20000 -->
        <part name="136045-1101.7a" crc="5a55f931" offset="0x0000" length="0x8000"/>   <!-- 30000 -->
        <part repeat="32768">00</part>                                                 <!-- 38000 -->
        <part name="136045-1107.6c" crc="e35e354e"/>                                    <!-- 40000 -->
        <part name="136045-1108.6de" crc="361db8b7"/>                                   <!-- 48000 -->
        <part name="136045-1104.7de" crc="d1f8fe7b" offset="0x8000" length="0x8000"/>  <!-- 50000 -->
        <part name="136045-1103.7c" crc="8f8c9692"/>                                    <!-- 58000 -->
        <part repeat="65536">00</part>                                                 <!-- 60000 -->
        <part name="136045-1104.7de" crc="d1f8fe7b" offset="0x0000" length="0x8000"/>  <!-- 70000 -->
        <part repeat="32768">00</part>                                                 <!-- 78000 -->

        <!-- motion objects: MAME "sprites" region, 256 KB of a 1 MB slot
             (the same eight ROMs as Super Sprint's; as dumped, the core
             inverts). Plane half 0 at slot offset 0, half 1 at 0x80000;
             the header's 11 motion object code bits wrap codes at 2048. -->
        <part name="136045-1112.6l" crc="f869b0fc"/>
        <part name="136045-1111.6k" crc="abcbc114"/>
        <part name="136045-1110.6hj" crc="9e91e734"/>
        <part name="136045-1109.6fh" crc="3a051f36"/>
        <part repeat="393216">00</part>
        <part name="136045-1116.6rs" crc="b15c1b90"/>
        <part name="136045-1115.6pr" crc="1dcdd5aa"/>
        <part name="136045-1114.6n" crc="fb5677d9"/>
        <part name="136045-1113.6m" crc="35e70a8d"/>
        <part repeat="393216">00</part>

        <!-- alphanumerics -->
        <part name="136045-1117.6t" crc="82da786d"/>

        <!-- EEPROM factory contents -->
        <part name="csprint-eeprom.bin" crc="ce1c7319"/>
    </rom>
</misterromdescription>
